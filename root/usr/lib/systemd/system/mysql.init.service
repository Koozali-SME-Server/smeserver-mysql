[Unit]
Description=Koozali SME Server mysql DB injector for mariadb
After=mariadb.service
Requires=mariadb.service

[Service]
Type=oneshot
Restart=no
TimeoutSec=10min
IgnoreSIGPIPE=no
KillMode=process
GuessMainPID=no
RemainAfterExit=yes
ExecStartPost=-/bin/bash -c '/usr/bin/grep -q "^TYPE=VIEW$" /var/lib/mysql/mysql/user.frm 2>/dev/null || /usr/bin/mariadb-upgrade --force'
ExecStart=/sbin/e-smith/systemd/mysql.init start
ExecStop=/sbin/e-smith/systemd/mysql.init stop
SyslogIdentifier=mysql.init

[Install]
WantedBy=sme-server.target
